# Backend Configuration

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/mairie_template"

# JWT
JWT_SECRET="votre_secret_jwt_tres_securise"

# URLs
FRONTEND_URL="http://localhost:3000"
BACKOFFICE_URL="http://localhost:3001"

# Email (SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@mairie-platform.ci"

# Environnement
NODE_ENV="development"
PORT=3000

# Autres
LOG_LEVEL="debug"
